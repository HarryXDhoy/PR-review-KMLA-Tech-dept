# Copy to .env.local, then restart Vite. Add the same public variables in Vercel.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# For legacy projects, leave PUBLISHABLE_KEY empty and set the public anon key:
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# NEVER put a service-role key, secret key, or database password in VITE_* variables.
